{
  "ci": {
    "collect": {
      "staticDistDir": "./site",
      "maxAutodiscoverUrls": 0,
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--disable-gpu --no-sandbox --no-zygote"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*404\\.html).*$",
          "assertions": {
            "categories:performance": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:accessibility": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:best-practices": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:seo": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}]
          }
        },
        {
          "matchingUrlPattern": ".*404\\.html$",
          "assertions": {
            "categories:performance": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:accessibility": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:best-practices": ["error", {"minScore": 1, "aggregationMethod": "optimistic"}],
            "categories:seo": ["warn", {"minScore": 0.6, "aggregationMethod": "optimistic"}]
          }
        }
      ]
    }
  }
}
